# YAW — contoh env untuk deploy Podman (compose).
# Salin ke `.env` di repo root lalu isi nilai CHANGE_ME:
#   cp .env.podman.example .env
# File `.env` JANGAN di-commit (sudah di-ignore, berisi secret).

APP_ENV=production
# Port host untuk backend (container selalu listen 3002):
APP_PORT=3002

# Database = service `db` di compose (jangan ubah host ke 127.0.0.1).
DB_HOST=db
DB_PORT=3306
DB_NAME=yaw
DB_USER=yaw_user
DB_PASSWORD=CHANGE_ME
# Dipakai image mariadb saat init + fallback root initDb:
DB_ROOT_PASSWORD=CHANGE_ME

# JWT — WAJIB diganti, minimal 32 karakter acak. Contoh:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_karakter_acak
JWT_EXPIRES_IN=7d

# Uploads di container (volume `uploads`, jangan ubah):
UPLOAD_PATH=/app/uploads

# CORS — origin web production (tanpa trailing slash)
CORS_ORIGIN=https://<domain>

# URL API publik yang di-bake ke Flutter web saat `make deploy-web` (wajib).
# WAJIB sama persis dengan URL yang dibuka user di browser (skema+host).
# Beda origin membuat semua request gagal di browser (CORS/TLS)
# walau curl langsung sukses.
API_BASE_URL=https://<domain>/api/v1
