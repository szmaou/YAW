APP_PORT=3002
APP_ENV=development

DB_HOST=127.0.0.1
# Default MariaDB port is 3306. Only change this if you remapped MariaDB (e.g. for another instance)
DB_PORT=3306
DB_NAME=yaw
DB_USER=yaw_user
DB_PASSWORD=yaw123

JWT_SECRET=yaw123
JWT_EXPIRES_IN=7d
# NOTE: On first DB start with an empty `users` table, initDb auto-seeds a
# default admin (see below). After real users exist the seed step is skipped.
# Default admin login:  admin@yaw.id / admin123  (role: admin)
# Default demo login:   user@yaw.id  / user123  (role: user)
# Run `npm run seed` to (re)seed these manually.

UPLOAD_PATH=./uploads
CORS_ORIGIN=*
