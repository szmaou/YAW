# YAW web — Flutter web build + nginx runtime
# Build context = repo root. Dipakai dari docker-compose.prod.yml:
#   build: { context: ., dockerfile: docker/Dockerfile.web,
#            args: { API_BASE_URL, BASE_HREF } }
FROM ghcr.io/cirruslabs/flutter:stable AS webbuild
WORKDIR /app

# API_BASE_URL wajib (tanpa default rahasia) — gagalkan build bila kosong.
ARG API_BASE_URL
ARG BASE_HREF=/
RUN test -n "$API_BASE_URL" || (echo "ARG API_BASE_URL kosong — isi API_BASE_URL di .env.prod" >&2; exit 1)

COPY pubspec.yaml ./
COPY lib ./lib
COPY web ./web
COPY assets ./assets
# `flutter --version` dicetak dulu agar mismatch Dart SDK terlihat di log.
RUN flutter --version
# dev_dependencies (riverpod_lint dkk) menuntut Dart >=3.13 sementara image
# flutter:stable mem-bundel 3.12 — dan `build web` tidak butuh dev-deps sama
# sekali (tidak ada codegen *.g.dart / @freezed / @riverpod di lib/).
# Strip dev-deps agar version-solving lolos dengan Dart image apa adanya.
RUN awk '/^dev_dependencies:/{skip=1;next} /^[^ \t#]/{skip=0} !skip' pubspec.yaml > pubspec.tmp \
 && mv pubspec.tmp pubspec.yaml \
 && flutter pub get
RUN if [ "$BASE_HREF" = "/" ]; then \
      flutter build web --release --dart-define=API_BASE_URL=$API_BASE_URL; \
    else \
      flutter build web --release --dart-define=API_BASE_URL=$API_BASE_URL --base-href "$BASE_HREF"; \
    fi

FROM nginx:alpine AS runtime
COPY --from=webbuild /app/build/web /usr/share/nginx/html
COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
