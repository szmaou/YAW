# YAW — contoh env production (native VPS: systemd + nginx + MariaDB).
# Salin ke lokasi prod lalu isi nilai CHANGE_ME:
#   cp .env.prod.example /opt/yaw/backend/.env
# File .env prod JANGAN di-commit (berisi secret).

APP_ENV=production
APP_PORT=3002

# Database native — komunikasi lokal via 127.0.0.1 (bukan tunnel).
# Domain/tunnel hanya untuk API_BASE_URL + CORS_ORIGIN.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yaw
DB_USER=yaw_user
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# JWT — WAJIB diganti, minimal 32 karakter acak. Contoh:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_karakter_acak
JWT_EXPIRES_IN=7d

# Uploads prod — path absolut di VPS (buat dir + chown ke user service).
UPLOAD_PATH=/var/lib/yaw/uploads

# CORS — origin web production (tanpa trailing slash)
CORS_ORIGIN=https://<domain>

# URL API publik yang dibake ke Flutter web saat build (wajib, tanpa default).
# WAJIB sama persis dengan URL yang dibuka user di browser (skema+host).
# Beda origin membuat semua request gagal di browser (CORS/TLS)
# walau curl langsung sukses.
API_BASE_URL=https://<domain>/api/v1
