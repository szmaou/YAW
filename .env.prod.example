# YAW — contoh env production. Salin ke .env.prod lalu isi nilai CHANGE_ME.
#   cp .env.prod.example .env.prod
# .env.prod JANGAN di-commit (berisi secret).

APP_ENV=production
APP_PORT=3002

# Database (dipakai service yaw-db + yaw-backend di docker-compose.prod.yml)
DB_NAME=yaw
DB_USER=yaw_user
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# JWT — WAJIB diganti, minimal 32 karakter acak. Contoh:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_karakter_acak

# CORS — origin web production (tanpa trailing slash)
CORS_ORIGIN=https://<domain>

# URL API publik yang dibake ke Flutter web saat build (wajib, tanpa default)
API_BASE_URL=https://<domain>/api/v1

# Base href Flutter web (default "/" — ubah hanya bila serve dari sub-path)
BASE_HREF=/
