# Satu unit systemd untuk auto-start stack YAW saat boot (Docker Compose).
# User biasa (docker rootless mode) — sesuai docs/DEPLOY.md §1:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/yaw-docker-compose.service ~/.config/systemd/user/
#   # sesuaikan WorkingDirectory ke folder checkout repo di VPS
#   vim ~/.config/systemd/user/yaw-docker-compose.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now yaw-docker-compose.service
#   loginctl enable-linger $USER       # unit tetap hidup tanpa sesi login
#   systemctl --user status yaw-docker-compose.service   # cek: active (exited), semua container Up
# Port host semua >1024 (compose.yaml WEB_PORT default 8080) — tanpa sudo/sysctl.
# Docker daemon (rootless) auto-start via sway pre-installed; unit hanya jalankan
# docker compose — jaruh dependency docker.service bila daemon belum siap.

[Unit]
Description=YAW stack (MariaDB + backend + web) via Docker Compose
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Sesuaikan ke folder checkout repo di VPS (mis. /home/<user>/yaw)
WorkingDirectory=%h/yaw
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=default.target
