# Satu unit systemd untuk auto-start stack YAW saat boot (Podman Compose).
# Rootless (user biasa) — sesuai docs/DEPLOY.md §1:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/yaw-compose.service ~/.config/systemd/user/
#   # sesuaikan WorkingDirectory ke folder checkout repo di VPS
#   vim ~/.config/systemd/user/yaw-compose.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now yaw-compose.service
#   loginctl enable-linger $USER       # unit tetap hidup tanpa sesi login
#   systemctl --user enable --now podman.socket
#   systemctl --user status yaw-compose.service   # cek: active (exited), semua container Up
# Port host semua >1024 (compose.yaml WEB_PORT default 8080) — tanpa sudo/sysctl.

[Unit]
Description=YAW stack (MariaDB + backend + web) via Podman Compose
Requires=podman.socket
Wants=network-online.target
After=network-online.target podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
# Sesuaikan ke folder checkout repo di VPS (mis. /home/<user>/yaw)
WorkingDirectory=%h/yaw
ExecStart=/usr/bin/podman compose up -d --build
ExecStop=/usr/bin/podman compose stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=default.target
