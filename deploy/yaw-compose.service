# Satu unit systemd untuk auto-start stack YAW saat boot (Podman Compose).
# Jalur root (rootful) — sesuai docs/DEPLOY.md §1:
#   cp deploy/yaw-compose.service /etc/systemd/system/
#   # sesuaikan WorkingDirectory ke folder checkout repo di VPS
#   vim /etc/systemd/system/yaw-compose.service
#   systemctl daemon-reload && systemctl enable --now yaw-compose.service
#   systemctl status yaw-compose.service   # cek: active (exited), semua container Up
#
# Variant rootless (user biasa): salin ke ~/.config/systemd/user/ ganti
# WorkingDirectory, lalu:
#   systemctl --user daemon-reload && systemctl --user enable --now yaw-compose.service
#   loginctl enable-linger $USER       # biarkan unit hidup tanpa sesi login
#   echo 'net.ipv4.ip_unprivileged_port_start=80' > /etc/sysctl.d/99-podman.conf
#   sysctl --system                     # sekali saja, jadi bisa bind port 80
# Unit user butuh `systemctl --user enable --now podman.socket`.

[Unit]
Description=YAW stack (MariaDB + backend + web) via Podman Compose
Requires=podman.socket
Wants=network-online.target
After=network-online.target podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
# Sesuaikan ke folder checkout repo di VPS (mis. /root/yaw atau /home/<user>/yaw)
WorkingDirectory=/root/yaw
ExecStart=/usr/bin/podman compose up -d --build
ExecStop=/usr/bin/podman compose stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
